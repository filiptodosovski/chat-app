{
  "name": "invit-app",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*",
    "packages/**/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "lint": "turbo lint",
    "build": "turbo build",
    "build:cms": "turbo build --filter=cms",
    "build:api": "turbo build --filter=api",
    "start": "turbo start",
    "api": "turbo dev --filter=api",
    "web": "turbo dev --filter=web",
    "postinstall": "husky"
  },
  "engines": {
    "npm": "please-use-yarn",
    "yarn": ">=1.22.15",
    "node": ">=18.12.1"
  },
  "devDependencies": {
    "husky": "9.0.11",
    "lint-staged": "^15.5.2",
    "turbo": "^2.10.11"
  },
  "resolutions": {
    "validator": "^13.15.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/testing": "11.2.1",
    "@nestjs/typeorm": "11.0.3",
    "@nestjs/websockets": "11.2.1",
    "next": "16.3.2",
    "tar": "^7.5.22",
    "typeorm": "0.3.31",
    "validator": "^13.15.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "unrs-resolver@1.12.2": true
  }
}
